# ---------------------------------------------------------------
# ShulePulse environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Beem Africa SMS (https://beem.africa)
BEEM_API_KEY=
BEEM_SECRET=
# Sender ID approved by Beem for your account (max 11 chars)
BEEM_SENDER_ID=INFO
# true = never call Beem, only log (safe for local development)
SMS_DRY_RUN=true

# Public URL of the app (used in password-reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
